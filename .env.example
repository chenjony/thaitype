# Copy to .env / .env.production and fill in real values.
# This project uses Vite, so variables must be prefixed with VITE_
# (not NEXT_PUBLIC_).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# OAuth redirect after Google / Facebook sign-in
# Production: https://thaitypes.com
# Local: http://localhost:5173
VITE_SITE_URL=https://thaitypes.com
